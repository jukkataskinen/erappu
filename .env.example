# --- Tietokanta ---
# pglite = paikallinen kehityskanta (.data/pglite), postgres = Supabase tai muu Postgres
DB_DRIVER=pglite
# Vain kun DB_DRIVER=postgres. Supabasen "Session pooler" -yhteysosoite.
DATABASE_URL=

# --- Kirjautuminen ---
# dev = kehityskirjautuminen (käyttäjän valinta listasta, EI tuotantoon), auth0 = eRapun Auth0-tenant (auth0/AJO-OHJE.md)
AUTH_MODE=dev
# Sovelluksen arvot kirjoittaa `npm run auth0:asetukset -- --aja`. AUTH0_SECRET: 32 bittiä hex.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Vain asetusskriptille: M2M-sovellus "Asetusskripti" (Auth0 Management API). Ei Verceliin.
AUTH0_MGMT_DOMAIN=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# --- Istuntojen ja linkkien allekirjoitus (32 satunnaista bittiä base64) ---
SESSION_SECRET=
LINK_TOKEN_SECRET=

# --- Kenttäsalaus (API-avaimet, henkilötunnukset) AES-256-GCM, 32 bittiä base64 ---
FIELD_ENCRYPTION_KEY=
HETU_PEPPER=

# --- Tiedostot ---
# local = .data/files, supabase = Supabase Storage
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- HTJ (Maanmittauslaitos) ---
# mock = kuvitteellinen data, mml = oikea rajapinta (vaatii MML-sopimuksen ja varmenteen)
HTJ_MODE=mock
# Tuotanto https://htj-ext.nls.fi/htj1/isannointi/v1, koeympäristö https://htj-ext-koe.nls.fi/htj1/isannointi/v1
HTJ_BASE_URL=https://htj-ext.nls.fi/htj1/isannointi/v1
# mTLS-varmenne ja avain (PEM) base64-muodossa (Vercel) ...
HTJ_CLIENT_CERT_BASE64=
HTJ_CLIENT_KEY_BASE64=
# ... tai paikallisessa koekäytössä polku git-ohitettuun tiedostoon (data/private/htj/)
HTJ_CLIENT_CERT_FILE=
HTJ_CLIENT_KEY_FILE=
HTJ_CLIENT_KEY_PASSPHRASE=
# Valinnainen: MML:n palvelimen CA-ketju base64-muodossa, jos sitä ei löydy järjestelmän varmennesäilöstä
HTJ_CA_BASE64=
# Isännöintiyrityksen Y-tunnus pakolliseen otsakkeeseen htj-isannointitaho
HTJ_ISANNOINTITAHO=
# Yksittäisen HTJ-kutsun aikaraja millisekunteina
HTJ_TIMEOUT_MS=20000

# --- eSinetti ---
# mock = paikallinen jäljitelmä, http = app.esinetti.fi
ESINETTI_MODE=mock
ESINETTI_API_URL=https://app.esinetti.fi/api/v1
ESINETTI_API_KEY=
ESINETTI_WEBHOOK_SECRET=

# --- Sähköposti ---
# console = tulostetaan lokiin ja tallennetaan er_outbound_messages, resend = oikea lähetys
EMAIL_MODE=console
RESEND_API_KEY=
EMAIL_FROM=eRappu <noreply@erappu.fi>

# --- Ajastetut tehtävät ---
# Bearer-salaisuus reiteille /api/cron/* (esim. viestijonon purku /api/cron/viestit).
# Tuotannossa pakollinen: ilman sitä reitit palauttavat 401. Kehityksessä tyhjä sallii ajon.
CRON_SECRET=
